{
  "name": "vellum",
  "private": true,
  "version": "0.10.1",
  "type": "module",
  "description": "a reading app that feels native everywhere",
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": "20 || >=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:e2e": "playwright test tests",
    "test:adapter": "node --test tests/api-resilience.test.mjs tests/anime-adapter.test.mjs tests/cineby.test.mjs tests/dramacooli.test.mjs tests/goplay.test.mjs tests/kisskh.test.mjs tests/kiss-sub.test.mjs",
    "web:build": "VITE_BASE=/Vellum/ VITE_WEB_ABS=1 vite build",
    "preview": "vite preview",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:linux": "bash scripts/build-linux.sh",
    "tauri": "tauri",
    "mobile:sync": "vite build && cap sync",
    "mobile:add:android": "cap add android",
    "mobile:add:ios": "cap add ios",
    "ios:build": "vite build && cap sync ios && cap build ios --scheme App",
    "cap": "cap",
    "test:unit": "node --test tests/*.test.mjs",
    "test:security": "bun audit",
    "test:e2e:offline": "playwright test tests --grep-invert @live",
    "test:e2e:live": "playwright test tests --grep @live"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@playwright/test": "1.61.0",
    "@tauri-apps/cli": "^2",
    "vite": "^6.4.6"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/ios": "^6.2.3",
    "@fontsource/archivo": "^5",
    "@fontsource/ibm-plex-mono": "^5",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2",
    "dompurify": "^3.4.17",
    "hls.js": "^1.6.13",
    "mux.js": "^6.3.0"
  },
  "overrides": {
    "glob": "^14.0.5",
    "tar": "^7.5.23"
  },
  "patchedDependencies": {
    "@capacitor/cli@6.2.3": "patches/@capacitor%2Fcli@6.2.3.patch"
  }
}
